# WorkforceAI Environment Configuration

# Application
APP_ENV=development
APP_NAME=WorkforceAI
DEBUG=true
SECRET_KEY=change-me-in-production-super-secret-key-at-least-32-chars-long
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/workforceai
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/workforceai

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Multi-Provider AI Routing Priority (comma-separated, tried in order)
LLM_ROUTING_ORDER=omniroute,openrouter,gemini,grok,local,deterministic

# 1. OmniRoute (Paste your OmniRoute key here)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_MODEL=auto

# 2. OpenRouter (Multi-model aggregator / free models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 2a. OpenRouter Free Decision Engine (Dedicated URL & Free Decision Model)
OPENROUTER_DECISION_API_KEY=
OPENROUTER_DECISION_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DECISION_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 2b. OpenRouter Chat Engine (Dedicated URL & Conversational Model)
OPENROUTER_CHAT_API_KEY=
OPENROUTER_CHAT_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 3. Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# 4. Grok (xAI)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-beta

# 5. Local / Near AI Models (Ollama, vLLM, Near AI)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# PayPal Developer Sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Integrations (Optional / Stretch)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
