# Leavify.ai Environment Configuration

# Application
APP_ENV=development
APP_NAME=Leavify.ai
DEBUG=true
SECRET_KEY=change-me-in-production-super-secret-key-at-least-32-chars-long
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leavify
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/leavify

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Multi-Provider AI Routing Priority (comma-separated, tried in order)
LLM_ROUTING_ORDER=omniroute,openrouter,gemini,grok,local,deterministic

# 1. OmniRoute (Paste your OmniRoute key here)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_MODEL=auto

# 2. OpenRouter (Multi-model aggregator / free models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# 2a. OpenRouter Free Decision Engine (Dedicated URL & Free Decision Model)
OPENROUTER_DECISION_API_KEY=
OPENROUTER_DECISION_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DECISION_MODEL=openrouter/free

# 2b. OpenRouter Chat Engine (Dedicated URL & Conversational Model)
OPENROUTER_CHAT_API_KEY=
OPENROUTER_CHAT_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openrouter/free

# 2c. OpenRouter Embeddings Engine (Dedicated Embedding Model)
OPENROUTER_EMBEDDING_API_KEY=
OPENROUTER_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# 3. Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=text-embedding-004

# 4. Grok (xAI) / GroqCloud
GROK_API_KEY=
GROK_BASE_URL=https://api.groq.com/openai/v1
GROK_MODEL=openai/gpt-oss-120b

# 5. Local / Near AI Models (Ollama, vLLM, Near AI)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# PayPal Developer Sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Cloud Email Service (HTTPS Port 443 - Recommended for Render Free Tier to bypass SMTP port blocks)
# Free 3,000 emails/mo at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Live Gmail Integration (IMAP Inbound + SMTP Outbound for Localhost)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-company-email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_EMAIL=your-company-email@gmail.com

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-company-email@gmail.com
IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Outbound Slack Webhook Integration (Block Kit Decision Cards)
# Create an Incoming Webhook at: https://api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/INCOMING/WEBHOOK
SLACK_NOTIFICATIONS_ENABLED=True
